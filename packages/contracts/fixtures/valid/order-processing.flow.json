          "id": "input",
          "label": "Entrada"
        }
      ],
      "outputs": [
        {
          "id": "next",
          "label": "Resultado"
        }
      ],
      "activationMode": "each",
      "durationMs": 500,
      "configuration": {
        "operations": []
      },
      "position": {
        "x": -50,
        "y": 80,
        "z": 0
      },
      "locked": false,
      "metadata": {
        "category": "inventory",
        "color": "#06B6D4"
      }
    },
    {
      "id": "inventory-available",
      "type": "decision",
      "label": "¿Hay inventario?",
      "description": "Dirige hacia preparación o reembolso.",
      "inputs": [
        {
          "id": "input",
          "label": "Entrada"
        }
      ],
      "outputs": [
        {
          "id": "available",
          "label": "Sí"
        },
        {
          "id": "unavailable",
          "label": "No"
        }
      ],
      "activationMode": "each",
      "durationMs": 10,
      "configuration": {
        "strategy": "first_match"
      },
      "position": {
        "x": 100,
        "y": 80,
        "z": 0
      },
      "locked": false,
      "metadata": {
        "category": "inventory",
        "color": "#F59E0B"
      }
    },
    {
