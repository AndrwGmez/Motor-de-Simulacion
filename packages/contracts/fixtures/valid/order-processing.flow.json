        {
          "id": "input",
          "label": "Entrada"
        }
      ],
      "outputs": [
        {
          "id": "approved",
          "label": "Sí"
        },
        {
          "id": "rejected",
          "label": "No"
        }
      ],
      "activationMode": "each",
      "durationMs": 10,
      "configuration": {
        "strategy": "first_match"
