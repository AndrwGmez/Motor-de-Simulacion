      "label": "Pedido recibido",
      "description": "Entrada de la simulación.",
      "inputs": [],
      "outputs": [
        {
          "id": "next",
          "label": "Continuar"
        }
      ],
      "activationMode": "each",
      "durationMs": 0,
      "configuration": {
        "eventName": "order.received"
      },
      "position": {
        "x": -500,
        "y": 0,
        "z": 0
      },
      "locked": false,
      "metadata": {
        "category": "orders",
        "color": "#38BDF8"
      }
    },
    {
