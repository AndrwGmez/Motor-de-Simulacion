{
  "schemaVersion": "1.0",
  "name": "Procesamiento de pedidos",
  "description": "Valida pago e inventario, prepara el pedido o devuelve el dinero.",
  "metadata": {
    "tags": [
      "pedidos",
      "demo"
    ],
    "createdWith": "FlowVerse 3D"
  },
  "variables": [
    {
      "path": "/payment/status",
      "type": "string",
      "required": true,
      "default": "pending"
    },
    {
      "path": "/inventory/available",
      "type": "boolean",
      "required": true,
      "default": false
    },
    {
      "path": "/order/status",
      "type": "string",
      "required": false,
      "default": "received"
    }
  ],
  "layout": {
    "mode": "directional",
    "camera": {
      "position": {
        "x": 0,
        "y": 120,
        "z": 700
      },
      "target": {
        "x": 100,
        "y": 0,
        "z": 0
      }
    }
  },
  "nodes": [
