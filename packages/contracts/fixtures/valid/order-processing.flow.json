        {
          "id": "input",
          "label": "Entrada"
        }
      ],
      "outputs": [
        {
          "id": "next",
          "label": "Continuar"
        }
      ],
      "activationMode": "each",
      "durationMs": 250,
      "configuration": {
        "operations": [
          {
            "op": "set",
            "path": "/order/status",
            "value": "refunded"
          }
        ]
      },
      "position": {
        "x": 250,
        "y": -80,
        "z": 0
      },
      "locked": false,
      "metadata": {
        "category": "payments",
        "color": "#14B8A6"
      }
    },
    {
      "id": "refunded",
      "type": "end",
      "label": "Pedido reembolsado",
      "description": "Termina correctamente la ruta de reembolso.",
      "inputs": [
        {
          "id": "input",
          "label": "Entrada"
        }
      ],
      "outputs": [],
      "activationMode": "each",
      "durationMs": 0,
      "configuration": {
        "result": "success",
        "output": {
          "status": "refunded"
        }
      },
      "position": {
        "x": 400,
        "y": -80,
        "z": 0
      },
      "locked": false,
      "metadata": {
        "category": "results",
        "color": "#22C55E"
      }
    },
    {
      "id": "prepare-order",
      "type": "process",
      "label": "Preparar pedido",
      "description": "Cambia el estado del pedido dentro de la simulación.",
