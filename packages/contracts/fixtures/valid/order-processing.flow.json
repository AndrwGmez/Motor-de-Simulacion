      "type": "integration",
      "label": "Enviar pedido",
      "description": "Representa un proveedor logístico simulado.",
      "inputs": [
        {
          "id": "input",
          "label": "Entrada"
        }
      ],
      "outputs": [
        {
          "id": "next",
          "label": "Enviado"
        }
      ],
      "activationMode": "each",
      "durationMs": 0,
      "configuration": {
        "service": "Demo Logistics",
        "latencyMs": 800,
        "outcome": "success",
        "response": {
          "trackingId": "SIM-0001"
        }
      },
      "position": {
        "x": 400,
        "y": 160,
        "z": 0
      },
      "locked": false,
      "metadata": {
        "category": "shipping",
        "color": "#A855F7"
      }
    },
