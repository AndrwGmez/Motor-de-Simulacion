      "inputs": [
        {
          "id": "input",
          "label": "Entrada"
        }
      ],
      "outputs": [],
      "activationMode": "each",
      "durationMs": 0,
      "configuration": {
        "result": "failure",
        "output": {
          "reason": "payment_rejected"
        }
      },
      "position": {
        "x": -50,
        "y": -200,
        "z": 0
      },
      "locked": false,
      "metadata": {
        "category": "results",
        "color": "#EF4444"
      }
    },
    {
