      "label": "Validar pago",
      "description": "Simula la validación del proveedor de pagos.",
      "inputs": [
        {
          "id": "input",
          "label": "Entrada"
        }
      ],
      "outputs": [
        {
          "id": "next",
          "label": "Resultado"
        }
      ],
      "activationMode": "each",
      "durationMs": 350,
      "configuration": {
        "operations": []
      },
      "position": {
        "x": -350,
        "y": 0,
        "z": 0
      },
      "locked": false,
      "metadata": {
        "category": "payments",
        "color": "#8B5CF6"
      }
    },
    {
      "id": "payment-approved",
