          "label": "Entrada"
        }
      ],
      "outputs": [
        {
          "id": "next",
          "label": "Continuar"
        }
      ],
      "activationMode": "each",
      "durationMs": 450,
      "configuration": {
        "operations": [
          {
            "op": "set",
