  "edges": [
    {
      "id": "edge-order-payment",
      "source": "order-received",
      "target": "validate-payment",
      "sourcePort": "next",
      "targetPort": "input",
      "label": "Nuevo pedido",
      "priority": 0,
      "isDefault": false
    },
    {
      "id": "edge-payment-decision",
      "source": "validate-payment",
      "target": "payment-approved",
      "sourcePort": "next",
      "targetPort": "input",
      "priority": 0,
      "isDefault": false
    },
    {
      "id": "edge-payment-approved",
      "source": "payment-approved",
      "target": "check-inventory",
      "sourcePort": "approved",
      "targetPort": "input",
      "label": "Sí",
      "condition": {
        "field": "/payment/status",
        "operator": "equals",
        "value": "approved"
      },
      "priority": 0,
      "isDefault": false
    },
    {
      "id": "edge-payment-rejected",
      "source": "payment-approved",
      "target": "payment-rejected",
      "sourcePort": "rejected",
      "targetPort": "input",
      "label": "No",
      "priority": 100,
      "isDefault": true
    },
    {
      "id": "edge-inventory-decision",
      "source": "check-inventory",
      "target": "inventory-available",
      "sourcePort": "next",
      "targetPort": "input",
      "priority": 0,
      "isDefault": false
    },
    {
      "id": "edge-inventory-available",
      "source": "inventory-available",
      "target": "prepare-order",
      "sourcePort": "available",
      "targetPort": "input",
      "label": "Sí",
      "condition": {
        "field": "/inventory/available",
        "operator": "equals",
        "value": true
      },
      "priority": 0,
      "isDefault": false
    },
    {
      "id": "edge-inventory-missing",
      "source": "inventory-available",
      "target": "refund-payment",
      "sourcePort": "unavailable",
      "targetPort": "input",
      "label": "No",
      "priority": 100,
      "isDefault": true
    },
    {
      "id": "edge-refund-end",
      "source": "refund-payment",
      "target": "refunded",
      "sourcePort": "next",
      "targetPort": "input",
      "priority": 0,
      "isDefault": false
    },
    {
      "id": "edge-prepare-ship",
      "source": "prepare-order",
      "target": "ship-order",
      "sourcePort": "next",
      "targetPort": "input",
      "priority": 0,
      "isDefault": false
    },
    {
      "id": "edge-ship-confirm",
      "source": "ship-order",
      "target": "confirm-delivery",
      "sourcePort": "next",
      "targetPort": "input",
      "priority": 0,
      "isDefault": false
    },
    {
      "id": "edge-confirm-end",
      "source": "confirm-delivery",
      "target": "delivered",
      "sourcePort": "next",
      "targetPort": "input",
      "priority": 0,
      "isDefault": false
    }
  ]
}

