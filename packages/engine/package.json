{
  "name": "@flowverse/engine",
  "version": "0.1.0",
  "type": "module",
  "description": "Validación estructural, simulación determinista e importación CSV.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "prepublishOnly": "tsup",
    "test": "vitest run"
  },
  "dependencies": {
    "@flowverse/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "tsup": "^8.5.0",
    "vitest": "^3.2.4"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "directory": "packages/engine"
  }
}
