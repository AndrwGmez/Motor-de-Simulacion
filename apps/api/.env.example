PORT=8080
APP_ENV=development
PUBLIC_ORIGIN=http://localhost:3000
PUBLIC_WS_ORIGIN=ws://localhost:8080
DATABASE_URL=postgres://flowverse:flowverse@localhost:5432/flowverse?sslmode=disable
STORE_DRIVER=memory
AUTO_MIGRATE=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
FLOW_PARSER_PROVIDER=mock
COPILOT_PROVIDER=mock
OPENAI_COPILOT_MODEL=gpt-4.1-mini
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
OTEL_ENABLED=false
OTEL_SERVICE_NAME=flowverse-api
OTEL_SERVICE_VERSION=dev
OTEL_SAMPLE_RATIO=1
OTEL_METRIC_INTERVAL=30s
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=
