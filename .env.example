# PostgreSQL used by Docker Compose
POSTGRES_DB=flowverse
POSTGRES_USER=flowverse
POSTGRES_PASSWORD=flowverse_local_password
POSTGRES_PORT=55433

# API
API_PORT=8080
APP_ENV=development
DATABASE_URL=postgres://flowverse:flowverse_local_password@localhost:55433/flowverse?sslmode=disable
STORE_DRIVER=postgres
AUTO_MIGRATE=true
PUBLIC_ORIGIN=http://localhost:3000
PUBLIC_WS_ORIGIN=ws://localhost:8080
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
FLOW_PARSER_PROVIDER=mock
COPILOT_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_COPILOT_MODEL=gpt-4.1-mini
OTEL_ENABLED=false
OTEL_SERVICE_NAME=flowverse-api
OTEL_SERVICE_VERSION=dev
OTEL_SAMPLE_RATIO=1
OTEL_METRIC_INTERVAL=30s
# Standard OTLP/HTTP endpoint inside Compose (`--profile observability`).
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_HEADERS=

# Web
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080
