# PostgreSQL used by Docker Compose
POSTGRES_DB=flowverse
POSTGRES_USER=flowverse
POSTGRES_PASSWORD=flowverse_local_password
POSTGRES_PORT=55433

# API
API_PORT=8080
APP_ENV=development
DATABASE_URL=postgres://flowverse:flowverse_local_password@localhost:55433/flowverse?sslmode=disable
STORE_DRIVER=postgres
AUTO_MIGRATE=true
PUBLIC_ORIGIN=http://localhost:3000
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
FLOW_PARSER_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Web
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080
